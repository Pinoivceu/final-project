// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../client/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Menggunakan String dengan default cuid() untuk keamanan URL
  id           String    @id @default(cuid())
  
  fullName     String    @map("full_name")
  username     String    @unique
  password     String    // Disimpan sebagai hash (argon2/bcrypt)
  
  // Role: 'owner' atau 'mandor'
  role         String    @default("mandor")
  // Foto Profil (Opsional)
  image        String?   @map("profile_picture")
  
  phoneNumber  String?   @db.VarChar(20) @map("phone_number")
  
  // Status akun
  status       String    @default("active") // active, inactive, suspended
  
  // Timestamps otomatis
  joinedAt     DateTime  @default(now()) @map("joined_at")
  lastLogin    DateTime? @map("last_login")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  lands           Land[]    @relation("MandorLands")
  treatmentLogs   TreatmentLog[]
  tasksAssigned   Task[]    @relation("MandorTasks")

  @@map("users")
}

model Land {
  id              String    @id @default(cuid())
  landName        String
  areaSize        Float
  locationAddress String?   @db.Text
  coordinates     Json?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive Boolean @default(true)

  // Foreign Key harus String karena merujuk ke User.id
  mandorId        String    
  mandor          User      @relation("MandorLands", fields: [mandorId], references: [id])
  
  plants          Plant[]
  treatmentLogs   TreatmentLog[]
  harvests        Harvest[]
  tasks           Task[]

  @@map("lands")
}

model Plant {
  id                 Int       @id @default(autoincrement())
  variety            String
  plantedAt          DateTime?
  locationCoordinate Json?
  status             String    @default("active")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  landId             String
  land               Land      @relation(fields: [landId], references: [id])

  @@map("plants")
}

model TreatmentLog {
  id              Int       @id @default(autoincrement())
  activityType    String
  description     String?   @db.Text
  executionDate   DateTime
  
  landId          String
  land            Land      @relation(fields: [landId], references: [id])
  
  // Foreign Key harus String
  mandorId        String    
  mandor          User      @relation(fields: [mandorId], references: [id])
  
  documentations  TreatmentDocumentation[]

  @@map("treatment_logs")
}

model TreatmentDocumentation {
  id             Int          @id @default(autoincrement())
  photoUrl       String
  caption        String?      @db.Text
  takenAt        DateTime?    @default(now())
  latitude       Float?
  longitude      Float?

  treatmentLogId Int
  treatmentLog   TreatmentLog @relation(fields: [treatmentLogId], references: [id])

  @@map("treatment_documentations")
}

model Harvest {
  id              String    @id @default(cuid())
  harvestDate     DateTime
  totalWeight     Float
  variety         String?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  landId          String
  land            Land      @relation(fields: [landId], references: [id])
  
 
 

  @@map("harvests")
}

model Task {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?   @db.Text
  activityType    String
  status          String    @default("pending")
  
  dueDate         DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  verifiedAt      DateTime?
  rejectionReason String?   @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  landId          String
  land            Land      @relation(fields: [landId], references: [id])
  
  // Semua yang merujuk ke User harus String
  mandorId        String    
  mandor          User      @relation("MandorTasks", fields: [mandorId], references: [id])
  
  
  @@map("tasks")
}