// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Menggunakan String dengan default cuid() untuk keamanan URL
  id           String    @id @default(cuid())
  
  fullName     String    @map("full_name")
  username     String    @unique
  password     String    // Disimpan sebagai hash (argon2/bcrypt)
  
  // Role: 'owner' atau 'mandor'
  role         String    @default("petani")
  
  // Foto Profil (Opsional)
  image        String?   @map("profile_picture")
  
  phoneNumber  String?   @db.VarChar(20) @map("phone_number")
  
  // Status akun
  status       String    @default("active") // active, inactive, suspended
  
  // Timestamps otomatis
  joinedAt     DateTime  @default(now()) @map("joined_at")
  lastLogin    DateTime? @map("last_login")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}